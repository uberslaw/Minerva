<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\minerva.ico</ApplicationIcon>
    <AssemblyName>CpuThrottle</AssemblyName>
    <RootNamespace>CpuThrottle.Tray</RootNamespace>
    <Description>Tray UI for launching modelling apps under a Windows CPU hard cap.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CpuThrottle.Core\CpuThrottle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\minerva.ico" LogicalName="CpuThrottle.Tray.Assets.minerva.ico" />
    <None Include="Assets\minerva.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
